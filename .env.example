# Copy to .env.local. Never commit credentials.
# The app starts in local outline mode. AI use requires opt-in in Settings.
MOTION_AI_BASE_URL=https://api.openai.com/v1
MOTION_AI_MODEL=
MOTION_AI_KEY=
# Optional data location; create/access it with the required filesystem permissions.
# MOTION_DATA_DIR=D:/AI-Workspace/Codex/motion-os/data
PORT=3100
