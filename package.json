{
  "name": "ai-video-studio",
  "version": "1.0.0",
  "private": true,
  "description": "Private, local-first AI-assisted video production studio",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "node scripts/build.mjs",
    "test": "node --test tests/studio.test.mjs packages/db/test/db.test.mjs && node --experimental-strip-types --test packages/schemas/test/schemas.test.mjs packages/timeline/test/timeline.test.mjs",
    "test:setup": "node packages/db/node_modules/prisma/build/index.js generate --schema packages/db/prisma/schema.prisma",
    "lint": "node apps/web/node_modules/typescript/bin/tsc --noEmit --project apps/web/tsconfig.json",
    "worker": "node --env-file-if-exists=.env.local scripts/worker.mjs"
  },
  "keywords": [
    "video",
    "ai",
    "remotion",
    "captions",
    "studio"
  ],
  "author": "",
  "license": "UNLICENSED",
  "dependencies": {
    "ffmpeg-static": "5.2.0",
    "ffprobe-static": "3.1.0",
    "gsap": "3.14.2",
    "hyperframes": "0.8.96"
  }
}
